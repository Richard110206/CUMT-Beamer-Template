\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{CUMT-campus}[2026/10/14 CUMT campus cover]
\RequirePackage{tikz}
\usetikzlibrary{fadings}
\definecolor{CUMTCoverBlue}{HTML}{1A3E8A}
\definecolor{CUMTInk}{HTML}{163367}
\definecolor{CUMTPale}{HTML}{EEF3FA}
\definecolor{CUMTLine}{HTML}{C8D8EC}
\definecolor{CUMTText}{HTML}{283343}
\setbeamercolor{normal text}{fg=CUMTText,bg=white}
\setbeamercolor{structure}{fg=CUMTCoverBlue}
\setbeamercolor{alerted text}{fg=CUMTCoverBlue}
\setbeamercolor{frametitle}{fg=CUMTCoverBlue,bg=white}
\setbeamercolor{titlelike}{fg=CUMTCoverBlue,bg=white}
\setbeamercolor{block title}{fg=CUMTInk,bg=CUMTLine!55!white}
\setbeamercolor{block body}{fg=CUMTText,bg=CUMTPale}
\setbeamercolor{block title example}{fg=CUMTInk,bg=CUMTLine!55!white}
\setbeamercolor{block body example}{fg=CUMTText,bg=CUMTPale}
\setbeamercolor{block title alerted}{fg=CUMTred,bg=CUMTred!9!white}
\setbeamercolor{block body alerted}{fg=CUMTText,bg=CUMTred!3!white}
\setbeamercolor{section in toc}{fg=CUMTCoverBlue}
\setbeamercolor{subsection in toc}{fg=CUMTText}
\setbeamercolor{section in toc shaded}{fg=CUMTCoverBlue!45!white}
\setbeamercolor{subsection in toc shaded}{fg=CUMTText!45!white}
\setbeamerfont{frametitle}{family=\heiti,series=\bfseries,size=\Large}
\setbeamerfont{block body}{family=\heiti}
\setbeamerfont{block title}{family=\heiti,series=\bfseries}
\setbeamertemplate{blocks}[default]
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=0.65cm,text margin right=0.65cm}
\setbeamertemplate{headline}{%
  \vskip0.28cm
  \hbox to\paperwidth{\hskip0.65cm
    {\color{CUMTCoverBlue!65!white}\heiti\scriptsize
      \ifnum\insertsectionnumber>0\insertsectionhead\else 中国矿业大学\fi}
    \hfill\includegraphics[width=3.0cm]{pic/cumt-logo-wordmark-vector.pdf}\hskip0.65cm}
  \vskip0.16cm
  \hbox to\paperwidth{\hskip0.65cm\color{CUMTLine}\rule{\dimexpr\paperwidth-1.3cm\relax}{0.4pt}\hfil}
}
\setbeamertemplate{frametitle}{%
  \vskip0.16cm
  \usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par
  \vskip0.12cm
}
\setbeamertemplate{footline}{%
  \hbox to\paperwidth{\hskip0.65cm\color{CUMTLine}\rule{\dimexpr\paperwidth-1.3cm\relax}{0.4pt}\hfil}
  \vskip0.10cm
  \hbox to\paperwidth{\hskip0.65cm
    {\heiti\fontsize{6.5}{9}\selectfont\color{CUMTCoverBlue!70!white}\insertshortauthor\quad\insertshorttitle}
    \hfill{\sffamily\fontsize{7}{9}\selectfont\color{CUMTInk}\insertframenumber\,/\,\inserttotalframenumber}\hskip0.65cm}
  \vskip0.18cm
}
\AtBeginSection[]{%
  \begin{frame}[shrink=5]{\insertsectionhead}
    \tableofcontents[sectionstyle=show/shaded,subsectionstyle=show/shaded/hide,subsubsectionstyle=show/shaded/hide]
  \end{frame}
}
\AtBeginSubsection[]{%
  \begin{frame}[shrink=5]{\insertsubsectionhead}
    \tableofcontents[sectionstyle=show/shaded,subsectionstyle=show/shaded/hide,subsubsectionstyle=show/shaded/hide]
  \end{frame}
}
% 正文建筑背景强度：0 完全隐藏，1 使用原图强度。
\newcommand{\CUMTContentBackgroundOpacity}{0.22}
\newcommand{\CUMTContentBackground}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west,inner sep=0pt,opacity=\CUMTContentBackgroundOpacity]
      at (current page.south west)
      {\includegraphics[width=\paperwidth,height=\paperheight]{pic/cumt-library-centered-bg.png}};
  \end{tikzpicture}%
}
\setbeamertemplate{background}{\CUMTContentBackground}
\newcommand{\CUMTCampusBackground}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west,inner sep=0pt] at (current page.south west)
      {\includegraphics[width=\paperwidth,height=\paperheight]{pic/cumt-traditional-gate-bg.png}};
    \fill[white,opacity=0.93] (current page.north east)
      rectangle ([xshift=8.3cm,yshift=-1.55cm]current page.north west);
    \fill[white,path fading=east] ([yshift=-1.55cm]current page.north west)
      rectangle ([xshift=11.5cm,yshift=-4.3cm]current page.north west);
    \fill[white,path fading=east] ([yshift=1.5cm]current page.south west)
      rectangle ([xshift=7.7cm,yshift=4.65cm]current page.south west);
  \end{tikzpicture}%
}
\newcommand{\CUMTCampusIdentity}{%
  \node[anchor=north east,inner sep=0pt] at
    ([xshift=-0.65cm,yshift=-0.42cm]current page.north east)
    {\includegraphics[width=4.1cm]{pic/cumt-logo-wordmark-vector.pdf}};
}
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \CUMTCampusIdentity
    \node[anchor=north west,inner sep=0pt,text width=9.5cm,align=left] at
      ([xshift=0.9cm,yshift=-1.68cm]current page.north west)
      {{\fontsize{26}{33}\selectfont\sffamily\bfseries\heiti\color{CUMTCoverBlue}\inserttitle\par}
       \vspace{0.25cm}
       {\fontsize{18}{25}\selectfont\heiti\color{CUMTCoverBlue}\insertsubtitle\par}
       \vspace{0.37cm}
       {\color{CUMTCoverBlue}\rule{2.5cm}{1.2pt}\par}};
    \node[anchor=north west,inner sep=0pt,text width=7cm,align=left] at
      ([xshift=0.9cm,yshift=-4.65cm]current page.north west)
      {{\fontsize{12}{18}\selectfont\sffamily\heiti\insertauthor\par}
       \vspace{0.27cm}
       {\fontsize{9}{14}\selectfont\sffamily\heiti\insertinstitute\par}
       \vspace{0.25cm}
       {\fontsize{10}{15}\selectfont\sffamily\insertdate\par}};
  \end{tikzpicture}%
}
